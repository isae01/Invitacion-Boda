# Neon: crear la base desde el tab "Storage" del proyecto en Vercel (o en neon.tech),
# copiar las dos connection strings que da (una pooled, una directa).

# Pooled (pgbouncer) — la usa la app en cada request normal.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"

# Directa (sin pooling) — solo la usan las migraciones de Prisma.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Firma los JWT de sesión del admin. Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="pon-aqui-un-valor-aleatorio-largo"

# Clave única para entrar al panel de admin (sin usuario, solo esta clave).
ADMIN_PASSWORD="jdyvaleria"
